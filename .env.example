# ReadVerse Environment Variables
# Path to locally stored light novels (defaults to ~/Documents/Officially Translated Light Novels if omitted)
LOCAL_LIGHTNOVELS_DIR=/Users/madworker/Documents/Officially Translated Light Novels

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=readverse_super_secret_session_key_replace_in_prod

# Google OAuth Credentials (Optional - Get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare D1 Database Credentials
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-cloudflare-d1-database-id
